# Valores de ejemplo; no son credenciales de un servicio desplegado.
# Node no carga este archivo automáticamente. Configure el entorno del proceso
# o use node --env-file=.env con una copia local ignorada por Git.
DATABASE_URL=postgresql://user:password@localhost:5432/devguardian

# local fuerza JSON aun si existe DATABASE_URL. Para la nube: postgres (o eliminar
# esta variable para seleccionar PostgreSQL automáticamente cuando haya URL).
DEVGUARDIAN_DB_MODE=local
DEVGUARDIAN_DB_PATH=./data/devguardian-db.json

# Cloud: configurar DATABASE_URL en el gestor de secretos del proveedor y usar
# TLS con validación de certificado (p. ej. sslmode=verify-full y su CA).
